<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="apic"
        Arguments=""
        InstallLocation="C:\Program Files\abcdlsj\apic">
    </Installer>
    <PackageInformation
        PackageName="apic"
        PackageDisplayName="apic"
        PublisherName="CN=abcdlsj"
        PublisherDisplayName="abcdlsj"
        Version="0.1.0.0"
        PackageDescription="Local-first API workbench">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.abcdlsj.apic"
                Description="Local-first API workbench"
                DisplayName="apic"
                ExecutableName="apic"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>apic</DisplayName>
            <PublisherDisplayName>abcdlsj</PublisherDisplayName>
            <Description>Local-first API workbench</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="apic.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
